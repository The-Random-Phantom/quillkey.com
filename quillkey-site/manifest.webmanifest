{
 "id": "./",
 "name": "quillkey",
 "short_name": "quillkey",
 "description": "A minimal text and code editor with a smooth caret, themes, live Markdown, and a Python/C++ runner.",
 "start_url": "./",
 "scope": "./",
 "display": "standalone",
 "background_color": "#16365a",
 "theme_color": "#16365a",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any maskable"
  },
  {
   "src": "icon.svg",
   "sizes": "any",
   "type": "image/svg+xml"
  }
 ],
 "file_handlers": [
  {
   "action": "./",
   "accept": {
    "text/plain": [
     ".txt",
     ".py",
     ".c",
     ".cpp",
     ".cc",
     ".cxx",
     ".h",
     ".hpp"
    ],
    "text/markdown": [
     ".md",
     ".markdown"
    ]
   }
  }
 ],
 "launch_handler": {
  "client_mode": "focus-existing"
 }
}